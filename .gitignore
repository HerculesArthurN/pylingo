.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testes e cobertura
coverage/
*.lcov

# Sistema
.cache/
