# ─────────────────────────────────────────────────────────
# PyLingo — .gitignore (Segurança & Sanitização)
# ─────────────────────────────────────────────────────────

# Dependências e Módulos de Terceiros
node_modules/
.pnp
.pnp.js
target/

# Builds e Artefatos de Produção
dist/
build/
out/
*.tsbuildinfo

# Ambientes Virtuais e Caches Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Segredos, Certificados e Credenciais (Privado / Confidencial)
.env*
!.env.example
*.pem
*.key
*.pfx
*.pkcs12
*.crt
*.cer
*.der
*.p12
secrets/
*.secret
credentials.json
serviceAccountKey.json

# Documentação Interna, Auditorias, Roadmaps e Planejamentos Privados
docs/internal/
*_audit.md
*_plan.md
*_revised.md
pylingo_*.md
pylingo_*.tsx
PRD.md
Plano de Arquitetura e Desenvolvimento Multi-Agente.md
*.internal.md

# Garantia Explícita de Rastreamento de Arquivos Públicos
!README.md
!CONTRIBUTING.md
!LICENSE
!.env.example
!docs/public/**

# Configurações de IDE e Editores Locais
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs de Execução e Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testes e Relatórios de Cobertura
coverage/
*.lcov

# Caches de Ferramentas e Bundlers
.cache/
.vite/
.eslintcache
