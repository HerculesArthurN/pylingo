# ==============================================================================
# PyLingo - Variáveis de Ambiente (Template de Configuração)
# ==============================================================================
# Copie este arquivo para .env.local ou .env para configurar a integração em nuvem.
# Nota: O PyLingo possui arquitetura offline-first e funciona plenamente mesmo sem
# credenciais configuradas (operando no modo Sandbox / Convidado local).
# ==============================================================================

# URL da instância Supabase (ex: https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima pública (anon key) do Supabase
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
